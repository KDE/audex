<ui version="4.0">
 <class>DeviceWidgetUI</class>
 <widget class="QWidget" name="DeviceWidgetUI">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>420</width>
    <height>400</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_device">
     <item>
      <widget class="QLabel" name="label_device">
       <property name="text">
        <string>Settings for drive:</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="comboBox_device">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox_features">
     <property name="title">
      <string>Drive features</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_features">
      <item>
       <widget class="QLabel" name="label_features">
        <property name="text">
         <string/>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_features">
        <item>
         <widget class="QPushButton" name="pushButton_assistant">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Reads a few short passages of the CD in the drive and measures how the drive behaves: read command size, accurate stream, audio cache, C2 error pointers, overread, Q sub-channel and, on request, the read offset. The settings below are filled in from the result.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Test this drive...</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacer_features">
          <property name="orientation">
           <enum>Qt::Orientation::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox_accuracy">
     <property name="title">
      <string>Reading accuracy</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_accuracy">
      <item>
       <widget class="QCheckBox" name="checkBox_secureMode">
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Reads every sector twice and reads again what differs until the copies agree. Slower, but reading errors do not go unnoticed. With AccurateRip or CTDB verification turned on, a track a database confirms after the first read is not read a second time (not for image profiles).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Secure mode</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_useC2">
        <item>
         <spacer name="horizontalSpacer_useC2">
          <property name="orientation">
           <enum>Qt::Orientation::Horizontal</enum>
          </property>
          <property name="sizeType">
           <enum>QSizePolicy::Policy::Fixed</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
        <item>
         <widget class="QCheckBox" name="checkBox_useC2">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use the C2 error pointers of the drive: a copy is only trusted if the drive reports no C2 errors. In secure mode this replaces the second pass. Not all drives support C2 pointers.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Use C2 error pointers</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="checkBox_cacheDefeat">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Force the drive to really re-read sectors instead of serving them from its cache: before every re-read a sector far away is read. Recommended for secure mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Defeat drive cache</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBox_overread">
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Try to read into the lead-in and lead-out areas. Only useful with a matching sample shift; most drives cannot overread.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Overread into lead-in and lead-out</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="formLayout_accuracy">
        <item row="0" column="0">
         <widget class="QLabel" name="label_retries">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;How often a sector that the drive does not deliver at all is read again before Audex gives up on it. In secure mode this only ends the re-reads of sectors that never return any data; sectors that do return data are decided by the comparison rounds. Every attempt on a damaged sector can take seconds.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Max. read retries:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QSpinBox" name="spinBox_retriesOnReadError">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;How often a sector that the drive does not deliver at all is read again before Audex gives up on it. In secure mode this only ends the re-reads of sectors that never return any data; sectors that do return data are decided by the comparison rounds. Every attempt on a damaged sector can take seconds.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="minimum">
           <number>0</number>
          </property>
          <property name="maximum">
           <number>200</number>
          </property>
          <property name="value">
           <number>20</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox_offset">
     <property name="title">
      <string>Read offset</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_offset">
      <item>
       <layout class="QFormLayout" name="formLayout_offset">
        <item row="0" column="0">
         <widget class="QLabel" name="label_sampleShift">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Some drives have a sample offset when reading audio CDs. To determine the correct offset for your drive model, you can check the &lt;a href="https://www.accuraterip.com/driveoffsets.htm"&gt;&lt;span style=" text-decoration: underline; color:#2980b9;"&gt;Accuraterip&lt;/span&gt;&lt;/a&gt; database.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Sample shift:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QSpinBox" name="spinBox_sampleShift">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Some drives have a sample offset when reading audio CDs. To determine the correct offset for your drive model, you can check the &lt;a href="https://www.accuraterip.com/driveoffsets.htm"&gt;&lt;span style=" text-decoration: underline; color:#2980b9;"&gt;Accuraterip&lt;/span&gt;&lt;/a&gt; database.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="minimum">
           <number>-10000</number>
          </property>
          <property name="maximum">
           <number>10000</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_fetch">
        <item>
         <widget class="QPushButton" name="pushButton_fetchOffset">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Looks up the read offset of this drive model in the AccurateRip drive database (accuraterip.com) and enters it into the spin box.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Fetch from AccurateRip</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="pushButton_detectOffset">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Measures the read offset with the CD in the drive. Works with any disc that is in the AccurateRip database and takes about a minute.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Detect with inserted CD</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacer_fetch">
          <property name="orientation">
           <enum>Qt::Orientation::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="label_offsetHint">
        <property name="text">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;small&gt;If the drive is not found automatically, detect the offset with a CD that is in the AccurateRip database, or look up the model in the &lt;a href="https://www.accuraterip.com/driveoffsets.htm"&gt;AccurateRip drive offset list&lt;/a&gt; and enter the value manually.&lt;/small&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="openExternalLinks">
         <bool>true</bool>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox_speed">
     <property name="title">
      <string>Speed</string>
     </property>
     <layout class="QFormLayout" name="formLayout_speed">
      <item row="0" column="0">
       <widget class="QLabel" name="label_readSpeed">
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Read speed in x (1x = 176.4 kB/s, 75 audio sectors per second). 0 lets the drive run at its maximum speed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Read speed (0 = maximum):</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="spinBox_readSpeed">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Read speed in x (1x = 176.4 kB/s, 75 audio sectors per second). 0 lets the drive run at its maximum speed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>64</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_errorReadSpeed">
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Read speed in x while recovering errors. 0 keeps the normal read speed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Read speed on errors (0 = unchanged):</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="spinBox_errorReadSpeed">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Read speed in x while recovering errors. 0 keeps the normal read speed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>64</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Orientation::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
