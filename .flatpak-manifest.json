{
    "id": "org.kde.audex",
    "branch": "master",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "audex",
    "tags": [
        "nightly"
    ],
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--device=all",
        "--filesystem=xdg-music:create",
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--system-talk-name=org.freedesktop.UDisks2"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/mkspecs",
        "/share/doc",
        "/share/info",
        "/share/man",
        "*.la"
    ],
    "modules": [
        {
            "name": "utf8cpp",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DUTF8_TESTS=OFF",
                "-DUTF8_SAMPLES=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/nemtrif/utfcpp/archive/refs/tags/v4.2.1.tar.gz",
                    "sha256": "6d6a5493a111884cc085ee31babfe6d9960c8fb08fc80a64852eaeea8323dbc1"
                }
            ]
        },
        {
            "name": "taglib",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_SHARED_LIBS=ON",
                "-DBUILD_TESTING=OFF",
                "-DBUILD_EXAMPLES=OFF",
                "-DBUILD_BINDINGS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://taglib.org/releases/taglib-2.1.tar.gz",
                    "sha256": "95b788b39eaebab41f7e6d1c1d05ceee01a5d1225e4b6d11ed8976e96ba90b0c"
                }
            ]
        },
        {
            "name": "opus",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static",
                "--disable-doc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz",
                    "sha256": "65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1"
                }
            ]
        },
        {
            "name": "libopusenc",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static",
                "--disable-examples"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://archive.mozilla.org/pub/opus/libopusenc-0.2.1.tar.gz",
                    "sha256": "8298db61a8d3d63e41c1a80705baa8ce9ff3f50452ea7ec1c19a564fe106cbb9",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 17877,
                        "url-template": "https://archive.mozilla.org/pub/opus/libopusenc-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "vorbis-tools",
            "buildsystem": "autotools",
            "no-autogen": true,
            "config-opts": [
                "--disable-ogg123",
                "--disable-oggdec",
                "--disable-ogginfo",
                "--disable-vcut",
                "--disable-vorbiscomment",
                "--disable-oggtest",
                "--disable-vorbistest",
                "--disable-curltest"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.xiph.org/releases/vorbis/vorbis-tools-1.4.3.tar.gz",
                    "sha256": "a1fe3ddc6777bdcebf6b797e7edfe0437954b24756ffcc8c6b816b63e0460dde",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5104,
                        "url-template": "https://downloads.xiph.org/releases/vorbis/vorbis-tools-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "org.kde.audex",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
